---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts, formatDate } from '../../posts';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { frontmatter: fm, Content } = post;
const others = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---
<Base title={`${fm.title} | She2She Media`} description={fm.description} image={fm.image} type="article">
  <article class="section">
    <div class="container narrow">
      <a href="/blog" class="back">All posts</a>
      <h1>{fm.title}</h1>
      <p class="meta">{fm.author} · <time datetime={new Date(fm.date).toISOString()}>{formatDate(fm.date)}</time></p>
      <img class="cover" src={fm.image} alt="" width="940" height="788" />
      <div class="prose"><Content /></div>
    </div>
  </article>
  <section class="section cream more">
    <div class="container">
      <h2>More from the blog</h2>
      <div class="grid">
        {others.map((p) => <a href={`/post/${p.slug}`}><img src={p.frontmatter.image} alt="" width="940" height="788" loading="lazy" /><span>{p.frontmatter.title}</span></a>)}
      </div>
    </div>
  </section>
  <CtaBand above="var(--cream)" heading="Want a second pair of eyes on your site?" body="Book a free 30-minute consultation and we'll look at it together." />
</Base>
<style>
  .back { font-size: 14px; font-weight: 600; text-decoration: none; display: inline-block; margin-bottom: 20px; }
  .back::before { content: "← "; }
  h1 { font-size: clamp(2rem, 4.4vw, 2.9rem); }
  .meta { color: var(--muted); font-size: 15px; }
  .cover { border-radius: var(--radius); margin: 28px 0 36px; }
  .prose { font-size: 18px; }
  .prose :global(h2), .prose :global(h3) { font-size: 1.4rem; margin-top: 1.8em; }
  .prose :global(li) { margin-bottom: .4em; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 20px; }
  .grid a { text-decoration: none; color: var(--ink); font-weight: 600; line-height: 1.35; }
  .grid img { border-radius: 14px; margin-bottom: 12px; }
  .grid a:hover span { color: var(--magenta-dark); text-decoration: underline; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .prose { font-size: 17px; } }
</style>
