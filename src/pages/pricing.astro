---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { spotsTotal, spotsLeft } from '../special';

const codeBuilds = [
  { name: 'Starter', pages: 'Up to 3 pages · about 2–3 weeks', price: '$1,300', items: ['Design in your brand', 'Mobile-first build', 'Contact form or booking link', 'Basic SEO', '14 days of post-launch fixes'] },
  { name: 'Standard', pages: '4 to 6 pages · about 3–5 weeks', price: '$1,750', items: ['Everything in Starter', 'Lead capture', 'Page plan and copy editing', '30 days of post-launch fixes'], featured: true },
  { name: 'Premium', pages: '7 to 10 pages · about 5–8 weeks', price: '$4,000', items: ['Everything in Standard', 'Blog setup', 'Email signup integration', 'Advanced SEO', '30 days of priority support'] },
];

const wixBuilds = [
  { name: 'Starter', pages: 'Up to 3 pages · about 2–3 weeks', price: '$1,600', items: ['Design in your brand', 'Mobile-first build', 'Contact form or booking link', 'Basic SEO', 'Recorded walkthrough of how to edit your site', '14 days of post-launch fixes'] },
  { name: 'Standard', pages: '4 to 6 pages · about 3–5 weeks', price: '$2,150', items: ['Everything in Starter', 'Lead capture', 'Page plan and copy editing', '30 days of post-launch fixes'], featured: true },
  { name: 'Premium', pages: '7 to 10 pages · about 5–8 weeks', price: '$4,900', items: ['Everything in Standard', 'Blog setup', 'Email signup integration', 'Advanced SEO', '30 days of priority support'] },
];
---
<Base
  title="Website & Marketing Prices for Small Businesses | She2She Media"
  description="Website builds from $1,300, monthly website care and social media plans. Real prices up front, before you book a call."
>
  <section class="section intro">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h1>Prices, up front</h1>
      <p class="lead">Every project starts with a free consultation, but you shouldn't have to book one just to find out what things cost.</p>
    </div>
  </section>

  <section id="special" class="container">
    <div class="special">
      <div class="special-head">
        <span class="pill">{spotsLeft > 0 ? `Limited offer · ${spotsLeft} of ${spotsTotal} spots left` : `All ${spotsTotal} spots claimed`}</span>
        <h2>Website rebrand special</h2>
        <p>For the first {spotsTotal} women business owners who sign on. It runs until all {spotsTotal} spots are taken.</p>
      </div>
      <div class="offers" data-stagger>
        <div class="offer">
          <h3>Full rebrand + 3-page website</h3>
          <p class="price">$497 <s>$2,050</s></p>
          <p class="usually">Usually $750 branding + $1,300 Starter website</p>
          <p>New color palette and fonts, a brand style guide, and a 3-page website in your new brand.</p>
        </div>
        <div class="offer">
          <h3>3-page website</h3>
          <p class="price">$297 <s>$1,300</s></p>
          <p class="usually">Usually the $1,300 Starter website</p>
          <p>Home, About and Contact pages in your current branding, mobile responsive, with a contact form.</p>
        </div>
      </div>
      <p class="code-only">Special prices are for sites built in code. Prefer Wix? <a href="/book-online">Ask for a quote</a> on your free consultation.</p>
      <div class="terms">
        <h3>Why the price is so low</h3>
        <p>I'm growing my portfolio. In return for the discount, I ask for a short testimonial once your site is live and permission to feature it on my Work page. Same build, same care, just a smaller invoice.</p>
        <h3>How to claim a spot</h3>
        <ol>
          <li>Book a free consultation, so we can both make sure it's a good fit.</li>
          <li>Your spot is secured when you sign on and pay the deposit.</li>
          <li>The count above goes down by one, and we get started.</li>
        </ol>
      </div>
      {spotsLeft > 0
        ? <a href="/book-online" class="btn white">Claim a spot</a>
        : <p class="full">This offer is full. The regular prices below still apply, and the free consultation is still free.</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Two ways to build</h2>
      <div class="ways" data-stagger>
        <div class="card way">
          <h3>Done for you</h3>
          <p class="way-for">For women who'd rather never log in to their website.</p>
          <dl>
            <dt>Built on</dt><dd>Modern code, hosted on Cloudflare, so it loads fast</dd>
            <dt>Who makes updates</dt><dd>Me, through Website care</dd>
            <dt>Monthly cost</dt><dd>$150 Website care, optional</dd>
            <dt>Hosting fees</dt><dd>None to speak of</dd>
            <dt>Handover</dt><dd>The site and code move into your own accounts</dd>
            <dt>Help later</dt><dd>Included in Website care</dd>
          </dl>
          <a href="#done-for-you" class="btn">See prices</a>
        </div>
        <div class="card way">
          <h3>Do it yourself</h3>
          <p class="way-for">For women who want to make their own changes, any time.</p>
          <dl>
            <dt>Built on</dt><dd>Wix</dd>
            <dt>Who makes updates</dt><dd>You, in the Wix editor</dd>
            <dt>Monthly cost</dt><dd>Your Wix plan, paid directly to Wix</dd>
            <dt>Hosting fees</dt><dd>Included in your Wix plan</dd>
            <dt>Handover</dt><dd>A recorded walkthrough of how to edit your site, with a layout set up to be hard to break</dd>
            <dt>Help later</dt><dd>$75 an hour, as needed</dd>
          </dl>
          <a href="#do-it-yourself" class="btn">See prices</a>
        </div>
      </div>
      <p class="ways-note"><strong>Same design, same care. The difference is who keeps it up to date.</strong> Website care is month to month, so you can cancel any time you don't need it. Either way, the site is yours.</p>
    </div>
  </section>

  <section id="done-for-you" class="section cream">
    <div class="container">
      <span class="eyebrow">Done for you</span>
      <h2>Website prices, built in code</h2>
      <p class="section-lead">A one-time price for the build. Updates afterwards through Website care, if you want them.</p>
      <div class="tiers" data-stagger>
        {codeBuilds.map((b) => (
          <div class:list={['card', 'tier', { featured: b.featured }]}>
            {b.featured && <span class="pill">Recommended</span>}
            <h3>{b.name}</h3>
            <p class="pages">{b.pages}</p>
            <p class="price">{b.price}</p>
            <ul class="check">{b.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="do-it-yourself" class="section">
    <div class="container">
      <span class="eyebrow">Do it yourself</span>
      <h2>Website prices, built on Wix</h2>
      <p class="section-lead">A one-time price for the build. Your Wix plan is paid separately, directly to Wix.</p>
      <div class="tiers" data-stagger>
        {wixBuilds.map((b) => (
          <div class:list={['card', 'tier', { featured: b.featured }]}>
            {b.featured && <span class="pill">Recommended</span>}
            <h3>{b.name}</h3>
            <p class="pages">{b.pages}</p>
            <p class="price">{b.price}</p>
            <ul class="check">{b.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="terms-row">
        <p><strong>Paid in three parts:</strong> a third to secure your start date, a third when the site is built, and the final third at handover, when the site moves into your own accounts.</p>
        <p><strong>Timelines</strong> start once I have your words and photos. A rebrand adds a week or two.</p>
      </div>
      <p class="fine">Payment terms and timelines are the same for both. Extra pages are $150 each. More details in the <a href="/faq">FAQ</a>.</p>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <h2>Monthly</h2>
      <div class="monthly" data-stagger>
        <div class="card">
          <h3>Website care</h3>
          <p class="price">$150<small>/month</small></p>
          <ul class="check">
            <li>Content updates</li>
            <li>Monthly testing of forms and links</li>
            <li>Speed and mobile check</li>
            <li>One small improvement</li>
          </ul>
          <p class="fine">Up to 2 hours of work a month. Additional projects are quoted and billed separately.</p>
        </div>
        <div class="card">
          <h3>Social media</h3>
          <p class="price">$500<small>/month</small></p>
          <ul class="check">
            <li>12 posts a month (3 a week)</li>
            <li>Monthly content calendar</li>
            <li>Captions and graphics for LinkedIn, Instagram and Facebook</li>
            <li>Scheduling after your weekly approval</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section addons">
    <div class="container">
      <h2>Branding and add-ons</h2>
      <div class="card addon">
        <div>
          <h3>Branding</h3>
          <p>A new color palette, font pairing and a brand style guide that shows how to use them, so your website, social media and everything else look like they came from the same business. Works on its own or alongside a website build.</p>
        </div>
        <p class="price">$750</p>
      </div>
      <div class="card addon" id="ai-photoshoot">
        <div>
          <h3>AI photoshoot</h3>
          <p>From a current photo of you, a consistent set of professional images for your site that still look like you. Real photos are always best; this is for when you don't have any you love.</p>
        </div>
        <p class="price">$250</p>
      </div>
    </div>
  </section>

  <CtaBand heading="Not sure which package fits?" body="We'll work it out on the call." />
</Base>

<style>
  .intro { padding-bottom: 32px; }
  .sub { font-size: 1rem; font-weight: 500; color: var(--muted); margin-left: 8px; letter-spacing: 0; }
  .pill { display: inline-block; background: #fff; color: var(--magenta-dark); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; border-radius: 999px; padding: 6px 14px; margin-bottom: 14px; }
  .special { background: var(--magenta); color: #fff; border-radius: var(--radius); padding: 40px; }
  .special h2, .special h3 { color: #fff; }
  .offers { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 24px 0 28px; }
  .offer { background: #fff; color: var(--ink); border-radius: 18px; padding: 24px; box-shadow: 0 14px 30px rgba(60,0,35,.2);
    background-image: radial-gradient(rgba(0,0,0,.035) 1px, transparent 1px); background-size: 4px 4px; }
  .special .offer h3 { color: var(--ink); }
  .offer, .tier { transition: transform .25s ease, box-shadow .25s ease; }
  .offer:hover { transform: translateY(-10px); box-shadow: 0 26px 44px rgba(60,0,35,.3); }
  .tier:hover { transform: translateY(-10px); box-shadow: 0 26px 44px rgba(168,37,111,.18); }
  @media (prefers-reduced-motion: reduce) { .offer:hover, .tier:hover { transform: none; } }
  .offer .price { color: var(--magenta-dark); }
  .offer s { font-size: 1.1rem; font-weight: 500; color: var(--muted); margin-left: 6px; }
  .offer p:not(.price) { color: var(--muted); }
  .usually { font-size: 14px; margin: -.4em 0 .9em; }
  .terms { background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.35); border-radius: 18px; padding: 24px; margin: 0 0 28px; }
  .terms h3 { font-size: 1.05rem; margin: 0 0 .4em; }
  .terms p { margin: 0 0 1.2em; }
  .terms ol { margin: 0; padding-left: 1.3em; }
  .terms li { margin-bottom: .3em; }
  .full { font-weight: 600; margin: 0; }
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 24px; align-items: start; }
  .tier { position: relative; }
  .tier.featured { border: 2px solid var(--magenta); }
  .tier .pill { background: var(--magenta); color: #fff; position: absolute; top: -14px; left: 28px; margin: 0; }
  .pages { color: var(--muted); margin-bottom: .4em; }
  .terms-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px; }
  .terms-row p { margin: 0; background: var(--cream); border-radius: 16px; padding: 18px 22px; font-size: 15px; }
  @media (max-width: 860px) { .terms-row { grid-template-columns: 1fr; } }
  .code-only { font-size: 15px; margin: -8px 0 28px; }
  .code-only a { color: #fff; text-decoration: underline; }
  .section-lead { color: var(--muted); max-width: 640px; margin: 0; }
  .ways { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
  .way-for { color: var(--muted); margin: 0 0 1em; }
  .way dl { margin: 0; }
  .way dt { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--magenta-dark); margin-top: 14px; }
  .way dd { margin: 2px 0 0; }
  .ways-note { margin-top: 24px; max-width: 720px; }
  .way { display: flex; flex-direction: column; }
  .way .btn { align-self: flex-start; margin-top: auto; }
  .way dl { margin-bottom: 24px; }
  @media (max-width: 860px) { .ways { grid-template-columns: 1fr; } }
  .fine { font-size: 14px; color: var(--muted); margin-top: 20px; }
  .monthly { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
  .addon { display: flex; align-items: center; justify-content: space-between; gap: 32px; margin-top: 24px; }
  .addon p:not(.price) { margin: 0; color: var(--muted); max-width: 640px; }
  .addon .price { margin: 0; flex: none; }
  @media (max-width: 860px) { .addon { flex-direction: column; align-items: flex-start; gap: 12px; } }
  @media (max-width: 860px) { .tiers, .monthly, .offers { grid-template-columns: 1fr; } .special { padding: 28px 22px; } .tier.featured { margin-top: 12px; } }
</style>
