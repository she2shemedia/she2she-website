---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | She2She Media" description="This page doesn't exist.">
  <section class="section">
    <div class="container narrow" style="text-align:center">
      <span class="eyebrow">404</span>
      <h1>This page has wandered off.</h1>
      <p class="lead" style="margin:0 auto 28px">It may have moved when the site was rebuilt. The homepage is a good place to start.</p>
      <a href="/" class="btn">Go to the homepage</a>
    </div>
  </section>
</Base>
