---
import Base from '../layouts/Base.astro';
import Torn from '../components/Torn.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="Websites & Marketing for Women-Owned Businesses | She2She Media"
  description="Clear, fast websites and social media for women-owned businesses. Plain language, real prices, and a free 30-minute consultation."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="copy" data-stagger>
        <h1>Websites and marketing for <span class="underline">women-owned businesses</span></h1>
        <p class="lead">I build clear, fast websites and handle the social media you don't have time for, so your business looks as good online as it is in real life.</p>
        <a href="/book-online" class="btn">Book a free consultation</a>
        <p class="small">30 minutes on Zoom. No pitch deck, no pressure.</p>
      </div>
      <div class="photo reveal" style="--d:300ms">
        <div class="frame">
          <img src="/images/anita.jpg" alt="Anita, founder of She2She Media, smiling in a magenta blouse with a castle behind her" width="720" height="765" fetchpriority="high" />
        </div>
        <div class="waves deco" aria-hidden="true"></div>
        <div class="hatch deco2" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <Torn top="#fff" bottom="var(--magenta)" />
  <section class="promo" aria-labelledby="promo-title">
    <svg class="promo-scribble" viewBox="0 0 300 260" aria-hidden="true">
      <path d="M40 40c80-40 220-30 230 30S120 130 70 100 120 20 210 60s60 120-30 130-150-20-110-60 140-10 160 40" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity=".8" />
    </svg>
    <div class="container promo-grid">
      <div class="promo-copy" data-stagger>
        <span class="promo-pill">Limited offer · first 5 only</span>
        <h2 id="promo-title">Website Rebrand Special</h2>
        <p>For the first 5 women business owners who book a free consultation.</p>
        <a href="/book-online" class="btn white">Claim a spot</a>
      </div>
      <div class="paper-wrap">
        <div class="paper" data-stagger>
          <div class="offer">
            <span class="o-label">Full rebrand + 3-page website</span>
            <span class="o-price">$497 <s>$2,050</s></span>
            <span class="o-note">New palette, fonts, style guide and a site to match</span>
          </div>
          <div class="offer">
            <span class="o-label">3-page website</span>
            <span class="o-price">$297 <s>$1,300</s></span>
            <span class="o-note">Home, About and Contact in your current branding</span>
          </div>
          <a href="/pricing#special" class="o-link">See what's included</a>
        </div>
        <img class="promo-badge" src="/images/she2she-badge.png" alt="" width="256" height="256" loading="lazy" />
      </div>
    </div>
    <div class="hatch promo-hatch" aria-hidden="true"></div>
  </section>
  <Torn top="var(--magenta)" bottom="#fff" flip />

  <section class="section">
    <div class="container narrow problem">
      <h2>You're running the business. The website can't be another job.</h2>
      <p class="lead">Most of the owners I work with built their own site at some point, usually late at night, and it shows. Not because they did it badly, but because a website is a lot of small decisions, and they had a business to run. That's the part I take off your plate.</p>
    </div>
  </section>

  <Torn top="#fff" bottom="var(--cream)" />
  <section class="section cream">
    <div class="container">
      <span class="eyebrow">What I do</span>
      <h2>Three ways I can help</h2>
      <div class="cards" data-stagger>
        <a class="card svc" href="/services#websites">
          <h3>Websites</h3>
          <p>A clear, mobile-first site built around one thing: getting the right people to contact you.</p>
          <p class="price">From $1,300</p>
        </a>
        <a class="card svc" href="/services#social">
          <h3>Social media</h3>
          <p>12 posts a month, 3 a week, planned, written, designed and scheduled in your brand, with your final OK before anything goes out.</p>
          <p class="price">$500<small>/month</small></p>
        </a>
        <a class="card svc" href="/services#care">
          <h3>Ongoing care</h3>
          <p>Updates, checks and small improvements every month, so your site doesn't quietly go stale.</p>
          <p class="price">$150<small>/month for 2 hours of work</small></p>
        </a>
      </div>
    </div>
  </section>
  <Torn top="var(--cream)" bottom="#fff" flip />

  <section class="section">
    <div class="container">
      <span class="eyebrow">How it works</span>
      <h2>Four stages, no black box</h2>
      <ol class="steps" data-stagger>
        <li style="--i:0"><span class="num">1</span><h3>Free consultation</h3><p>We talk about your business, your customers and what the site needs to do.</p></li>
        <li style="--i:1"><span class="num">2</span><h3>Words first</h3><p>We plan the pages and the copy before any design. This is the step that makes everything else faster.</p></li>
        <li style="--i:2"><span class="num">3</span><h3>Design and build</h3><p>Your brand, real photos, built for phones first.</p></li>
        <li style="--i:3"><span class="num">4</span><h3>Launch and care</h3><p>SEO basics and a speed check at launch, then regular updates if you want them.</p></li>
      </ol>
    </div>
  </section>

  <section class="section tight">
    <div class="container work">
      <a href="https://dogsthatcook.com" class="browser" aria-label="Visit dogsthatcook.com">
        <span class="chrome" aria-hidden="true"><i></i><i></i><i></i><b>dogsthatcook.com</b></span>
        <span class="shot">
          <!-- TODO: replace with a real screenshot at /images/work/dogs-that-cook.jpg -->
          <span class="shot-title">Dogs That Cook</span>
          <span class="shot-sub">Recipes for humans, hosted by two Jack Russell terriers</span>
        </span>
      </a>
      <div>
        <span class="eyebrow">Recent work</span>
        <h2>Dogs That Cook</h2>
        <p>A real recipe blog, hosted by two Jack Russell terriers. I built a searchable recipe database with filters by ingredient, diet and meal type, in a playful brand that doesn't get in the way of the food.</p>
        <a href="/work">See more work</a>
      </div>
    </div>
  </section>

  <CtaBand heading="Not sure what you need yet?" body="That's what the call is for. Bring your current site, or the lack of one, and we'll work out the next step together." />
</Base>

<style>
  .hero { padding: 64px 0 72px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .copy .lead { margin-bottom: 32px; }
  .small { font-size: 14px; color: var(--muted); margin-top: 14px; }
  .photo { position: relative; }
  .frame { position: relative; z-index: 1; border-radius: var(--radius); overflow: hidden; box-shadow: 0 24px 48px rgba(168,37,111,.18); border: 8px solid #fff; }
  .deco { position: absolute; right: -28px; bottom: -36px; width: 120px; height: 220px; z-index: 0; }
  .deco2 { position: absolute; left: -26px; top: 36px; width: 110px; height: 70px; z-index: 0; opacity: .85; }
  .promo { background: var(--magenta); color: #fff; position: relative; overflow: hidden; padding: 56px 0 72px; }
  .promo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; position: relative; z-index: 1; }
  .promo h2 { color: #fff; font-size: clamp(2.2rem, 4.6vw, 3.4rem); margin-bottom: .35em; }
  .promo-copy p { font-size: 1.15rem; max-width: 420px; margin-bottom: 28px; }
  .promo-pill { display: inline-block; background: #fff; color: var(--magenta-dark); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; border-radius: 999px; padding: 8px 18px; margin-bottom: 18px; }
  .promo-scribble { position: absolute; right: -30px; top: -20px; width: 340px; }
  .promo-hatch { position: absolute; left: 0; bottom: 0; width: 220px; height: 54px; background: repeating-linear-gradient(-55deg, var(--teal) 0 3px, transparent 3px 14px); opacity: .9; }
  .paper-wrap { position: relative; }
  .paper { background: #fff; color: var(--ink); padding: 44px 36px 36px; transform: rotate(-1.6deg); box-shadow: 0 20px 40px rgba(60,0,35,.25);
    clip-path: polygon(0 3%, 4% 1%, 9% 3.5%, 14% .5%, 20% 3%, 26% 1%, 31% 3.5%, 37% .8%, 43% 2.8%, 49% .4%, 55% 3%, 61% 1.2%, 67% 3.4%, 73% .6%, 79% 2.7%, 85% .8%, 91% 3.2%, 96% 1%, 100% 2.6%, 100% 100%, 0 100%);
    background-image: radial-gradient(rgba(0,0,0,.035) 1px, transparent 1px); background-size: 4px 4px; }
  .offer { display: grid; gap: 2px; padding: 16px 0; border-bottom: 2px dashed var(--lilac); }
  .o-label { font-weight: 700; font-size: 1.05rem; }
  .o-price { font-size: 2.4rem; font-weight: 700; color: var(--magenta-dark); line-height: 1.15; }
  .o-price s { font-size: 1.05rem; font-weight: 500; color: var(--muted); margin-left: 8px; }
  .o-note { font-size: 15px; color: var(--muted); }
  .o-link { display: inline-block; margin-top: 18px; font-weight: 600; }
  .o-link::after { content: " →"; }
  .promo-badge { position: absolute; right: -18px; bottom: -34px; width: 104px; height: 104px; background: #fff; border-radius: 50%; padding: 8px; box-shadow: 0 8px 20px rgba(0,0,0,.15); z-index: 2; }
  @media (prefers-reduced-motion: no-preference) {
    .paper { animation: paper-float 7s ease-in-out infinite; }
    @keyframes paper-float { 0%, 100% { transform: rotate(-1.6deg) translateY(0); } 50% { transform: rotate(-.6deg) translateY(-8px); } }
  }
  .problem { text-align: center; }
  .problem .lead { margin: 0 auto; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
  .cards { perspective: 1200px; }
  .svc { text-decoration: none; color: var(--text); display: flex; flex-direction: column; border-top: 6px solid var(--magenta); will-change: transform; }
  .svc.reveal.in { transition: opacity 1s ease, transform .6s cubic-bezier(.22,.61,.36,1), box-shadow .6s ease; }
  .cards .svc:hover, .cards .svc:focus-visible { color: var(--text); transform: translateY(-14px) scale(1.04); box-shadow: 0 28px 50px rgba(168,37,111,.20); z-index: 2; }
  .svc:hover .price { color: var(--magenta-dark); }
  @media (prefers-reduced-motion: reduce) { .cards .svc:hover, .cards .svc:focus-visible { transform: none; } }
  .svc .price { margin-top: auto; font-size: 1.5rem; }
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .steps li { position: relative; }
  .num { position: relative; display: inline-flex; width: 56px; height: 56px; border-radius: 50%; background: var(--magenta); color: #fff; font-weight: 700; font-size: 22px; align-items: center; justify-content: center; margin-bottom: 16px; z-index: 1; }
  /* Dashed line linking each step to the next (four-across layout only) */
  .steps li:not(:last-child)::before { content: ""; position: absolute; top: 27px; left: 68px; right: -16px; border-top: 2px dashed var(--lilac); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    /* Numbers pop in and the connecting line draws across as each step arrives */
    :global(.motion) .steps li .num { transform: scale(.2) rotate(-120deg); }
    :global(.motion) .steps li.in .num { transform: none; transition: transform .9s cubic-bezier(.34,1.56,.64,1) calc(var(--d, 0ms) + 250ms); }
    :global(.motion) .steps li:not(:last-child)::before { transform: scaleX(0); }
    :global(.motion) .steps li.in:not(:last-child)::before { transform: scaleX(1); transition: transform 1.1s ease-out calc(var(--d, 0ms) + 700ms); }
    /* A soft ring ripples out from each number in turn, 1 → 2 → 3 → 4, on a loop */
    .num::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 3px solid var(--magenta); opacity: 0; animation: ping 8s ease-out infinite; animation-delay: calc(2.5s + var(--i) * 2s); }
    @keyframes ping { 0% { transform: scale(1); opacity: .65; } 18% { transform: scale(1.9); opacity: 0; } 100% { transform: scale(1.9); opacity: 0; } }
    .steps li:hover .num { animation: flip .8s ease; }
    @keyframes flip { from { transform: rotateY(0); } to { transform: rotateY(360deg); } }
  }
  .work { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
  .browser { display: block; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 18px 40px rgba(0,0,0,.08); text-decoration: none; }
  .chrome { display: flex; align-items: center; gap: 6px; background: #f1edef; padding: 12px 16px; }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: var(--lilac); }
  .chrome b { margin-left: 12px; font-weight: 500; font-size: 13px; color: var(--muted); background: #fff; padding: 4px 12px; border-radius: 999px; }
  .shot { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; aspect-ratio: 16 / 10; background: var(--magenta-soft); padding: 24px; }
  .shot-title { font-size: 1.8rem; font-weight: 700; color: var(--ink); }
  .shot-sub { color: var(--muted); }
  @media (max-width: 900px) {
    .hero { padding-top: 40px; }
    .hero-grid, .work { grid-template-columns: 1fr; gap: 40px; }
    .photo { max-width: 420px; margin: 0 auto; }
    .cards { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .steps li::before { display: none; }
    .promo-grid { grid-template-columns: 1fr; gap: 40px; }
    .paper-wrap { max-width: 480px; }
  }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } .paper { padding: 36px 24px 28px; } .promo-badge { width: 84px; height: 84px; right: -6px; } .deco { right: -12px; } .deco2 { left: -10px; } }
</style>
