---
import Base from '../layouts/Base.astro';
import Waves from '../components/Waves.astro';
import Torn from '../components/Torn.astro';
import CtaBand from '../components/CtaBand.astro';
import LoopVideo from '../components/LoopVideo.astro';
import { spotsTotal, spotsLeft } from '../special';
import { giveawayClosesIso } from '../giveaway';

// Recent work slider on the homepage. To add a client, add an entry here: the recording
// and still image go in public/images/work/. Projects show in this order.
const projects = [
  {
    name: 'Dogs That Cook',
    url: 'https://dogsthatcook.com',
    domain: 'dogsthatcook.com',
    video: '/images/work/dogs-that-cook.mp4',
    poster: '/images/work/dogs-that-cook.jpg',
    w: 1400, h: 716,
    alt: 'A screen recording scrolling down the Dogs That Cook website homepage and its animations',
    blurb: "A real recipe blog, hosted by two Jack Russell terriers. I built a searchable recipe database with filters by ingredient, diet and meal type, in a playful brand that doesn't get in the way of the food.",
  },
  {
    name: 'Elevare Franchise Solutions',
    url: 'https://elevarefranchise.com',
    domain: 'elevarefranchise.com',
    video: '/images/work/elevare.mp4',
    poster: '/images/work/elevare.jpg',
    w: 1400, h: 724,
    alt: 'A screen recording scrolling down the Elevare Franchise Solutions website homepage',
    blurb: 'Fractional franchise leadership for emerging and growing franchise brands. I built a new website, a brand standards guide, a HubSpot contact form and branded email templates, so the online presence matches the level of the work.',
  },
];
---
<Base
  title="Websites & Marketing for Women-Owned Businesses | She2She Media"
  description="Clear, fast websites and social media for women-owned businesses. Plain language, real prices, and a free 30-minute consultation."
>
  <!-- Giveaway banner: hides itself once entries close (date in src/giveaway.ts). Delete this block after the giveaway. -->
  <a href="/giveaway" class="give-bar" id="give-bar" aria-label="Giveaway: win a 3-page website, actually free. Entries close Monday, November 30 at 11am Eastern. Enter now.">
    <span class="gb-track" aria-hidden="true">
      <span class="gb-set"><span class="gb-item"><span class="gb-tag">Giveaway</span><span class="gb-text">Win a 3-page website, <span class="gb-em">"actually free."</span> Entries close Monday, November 30 at 11am Eastern.</span><span class="gb-cta">Enter now &rarr;</span></span><span class="gb-item"><span class="gb-tag">Giveaway</span><span class="gb-text">Win a 3-page website, <span class="gb-em">"actually free."</span> Entries close Monday, November 30 at 11am Eastern.</span><span class="gb-cta">Enter now &rarr;</span></span><span class="gb-item"><span class="gb-tag">Giveaway</span><span class="gb-text">Win a 3-page website, <span class="gb-em">"actually free."</span> Entries close Monday, November 30 at 11am Eastern.</span><span class="gb-cta">Enter now &rarr;</span></span></span>
      <span class="gb-set"><span class="gb-item"><span class="gb-tag">Giveaway</span><span class="gb-text">Win a 3-page website, <span class="gb-em">"actually free."</span> Entries close Monday, November 30 at 11am Eastern.</span><span class="gb-cta">Enter now &rarr;</span></span><span class="gb-item"><span class="gb-tag">Giveaway</span><span class="gb-text">Win a 3-page website, <span class="gb-em">"actually free."</span> Entries close Monday, November 30 at 11am Eastern.</span><span class="gb-cta">Enter now &rarr;</span></span><span class="gb-item"><span class="gb-tag">Giveaway</span><span class="gb-text">Win a 3-page website, <span class="gb-em">"actually free."</span> Entries close Monday, November 30 at 11am Eastern.</span><span class="gb-cta">Enter now &rarr;</span></span></span>
    </span>
  </a>
  <script is:inline define:vars={{ closesAt: giveawayClosesIso }}>
    if (Date.now() >= Date.parse(closesAt)) { var gb = document.getElementById('give-bar'); if (gb) gb.remove(); }
  </script>

  <section class="hero">
    <div class="container hero-grid">
      <div class="copy" data-stagger>
        <h1>Websites and marketing for <span class="underline">women-owned businesses</span></h1>
        <p class="lead">I build clear, fast websites and handle the social media you don't have time for, so your business looks as good online as it is in real life.</p>
        <a href="/book-online" class="btn">Book a free consultation</a>
        <p class="small">30-minute video call. No pitch deck, no pressure.</p>
      </div>
      <div class="photo reveal" style="--d:300ms">
        <div class="frame">
          <LoopVideo src="/images/hero/anita-working-cabin.mp4" poster="/images/hero/anita-working-cabin.jpg" alt="Anita in a magenta blouse going through a website on a laptop with a client, in a warm wood-panelled room with a fire burning" width={1440} height={960} />
        </div>
        <div class="deco" aria-hidden="true"><Waves width={120} height={220} /></div>
        <div class="hatch deco2" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <Torn top="#fff" bottom="var(--magenta)" />
  <section class="promo" aria-labelledby="promo-title">
    <div class="container promo-grid">
           <div class="promo-copy" data-stagger>
        <span class="promo-pill">{spotsLeft > 0 ? `Limited offer · ${spotsLeft} of ${spotsTotal} spots left` : `All ${spotsTotal} spots claimed`}</span>
        <h2 id="promo-title">Website Rebrand Special</h2>
        <p>For the first {spotsTotal} women business owners who sign on. In return, I ask for a short testimonial and permission to feature your new site in my portfolio.</p>
        {spotsLeft > 0
          ? <a href="/book-online" class="btn white">Claim a spot</a>
          : <a href="/pricing" class="btn white">See current prices</a>}
      </div>
      <div class="paper-wrap">
        <div class="paper" data-stagger>
          <div class="offer">
            <span class="o-label">Full rebrand + 3-page website</span>
            <span class="o-price">$497 <s>$2,050</s></span>
            <span class="o-note">New palette, fonts, style guide and a site to match</span>
          </div>
          <div class="offer">
            <span class="o-label">3-page website</span>
            <span class="o-price">$297 <s>$1,300</s></span>
            <span class="o-note">Home, About and Contact in your current branding</span>
          </div>
          <a href="/pricing#special" class="o-link">See what's included</a>
        </div>
        <img class="promo-badge" src="/images/she2she-badge.png" alt="" width="512" height="512" loading="lazy" />
      </div>
    </div>
  </section>
  <Torn top="var(--magenta)" bottom="#fff" flip />

  <section class="section">
    <div class="container narrow problem">
      <h2>You're running the business. The website can't be another job.</h2>
      <p class="lead">Most of the owners I work with built their own site at some point, usually late at night, and it shows. Not because they did it badly, but because a website is a lot of small decisions, and they had a business to run. That's the part I take off your plate.</p>
    </div>
  </section>

  <section class="section cream">
    <div class="container">
      <span class="eyebrow">What I do</span>
      <h2>Three ways I can help</h2>
      <div class="cards" data-stagger>
        <a class="card svc" href="/services#websites">
          <h3>Websites</h3>
          <p>A clear, mobile-first site built around one thing: getting the right people to contact you.</p>
          <p class="price">From $1,300</p>
        </a>
        <a class="card svc" href="/services#social">
          <h3>Social media</h3>
          <p>12 posts a month, 3 a week, planned, written, designed and scheduled in your brand, with your final OK before anything goes out.</p>
          <p class="price">$500<small>/month</small></p>
        </a>
        <a class="card svc" href="/services#care">
          <h3>Ongoing care</h3>
          <p>Updates, checks and small improvements every month, so your site doesn't quietly go stale.</p>
          <p class="price">$150<small>/month for 2 hours of work</small></p>
        </a>
      </div>
    </div>
  </section>

  <section class="section how">
    <div class="container">
      <span class="eyebrow">How it works</span>
      <h2>Four stages, no black box</h2>
      <ol class="steps" data-stagger>
        <li style="--i:0"><span class="num">1</span><h3>Free consultation</h3><p>We talk about your business, your customers and what the site needs to do.</p></li>
        <li style="--i:1"><span class="num">2</span><h3>Words first</h3><p>We plan the pages and the copy before any design. This is the step that makes everything else faster.</p></li>
        <li style="--i:2"><span class="num">3</span><h3>Design and build</h3><p>Your brand, real photos, built for phones first.</p></li>
        <li style="--i:3"><span class="num">4</span><h3>Launch and care</h3><p>SEO basics and a speed check at launch, then regular updates if you want them.</p></li>
      </ol>
    </div>
  </section>

  <section class="section work-section" aria-roledescription="carousel" aria-label="Recent work">
    <div class="container">
      <div class="work-clip">
        <div class="work-track">
          {projects.map((p, i) => (
            <div class="work slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${projects.length}: ${p.name}`} data-name={p.name}>
              <a href={p.url} class="browser" aria-label={`Visit ${p.domain}`} tabindex={i === 0 ? undefined : -1}>
                <span class="chrome" aria-hidden="true"><i></i><i></i><i></i><b>{p.domain}</b></span>
                <LoopVideo src={p.video} poster={p.poster} alt={p.alt} width={p.w} height={p.h} managed />
              </a>
              <div>
                <span class="eyebrow">Recent work</span>
                <h2>{p.name}</h2>
                <p>{p.blurb}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="work-controls">
        <button class="ws-arrow" type="button" data-prev aria-label="Previous project">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="ws-dots">
          {projects.map((p, i) => (
            <button class="ws-dot" type="button" data-dot={i} aria-label={`Show ${p.name}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
        <button class="ws-arrow" type="button" data-next aria-label="Next project">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <a href="/work" class="ws-more">See more work</a>
      </div>
    </div>
  </section>

  <script>
    // Recent work slider. Each project's recording plays once, then the whole project
    // (screenshot and description) swipes left to the next one, looping round endlessly.
    // It pauses off screen, waits while someone is hovering or using the controls,
    // and never moves on its own for visitors who've turned on "reduce motion".
    const section = document.querySelector<HTMLElement>('.work-section');
    const track = section?.querySelector<HTMLElement>('.work-track');
    if (section && track && track.children.length > 1) {
      const GAP = 80;               // space between projects while they slide, in pixels
      const FALLBACK = 14000;       // if a recording can't play, move on after this long
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const names = Array.from(track.children).map((el) => (el as HTMLElement).dataset.name);
      const dots = Array.from(section.querySelectorAll<HTMLButtonElement>('.ws-dot'));
      let busy = false, visible = false, holding = false, timer = 0;

      const slides = () => Array.from(track.children) as HTMLElement[];
      const current = () => names.indexOf(slides()[0].dataset.name);
      const video = (el: Element) => el.querySelector('video') as HTMLVideoElement | null;
      const shift = (n: number) => `translateX(calc(${-n} * (100% + ${GAP}px)))`;

      function settle() {
        slides().forEach((el, i) => {
          const v = video(el);
          if (v && i > 0) { v.pause(); v.currentTime = 0; }
          el.setAttribute('aria-hidden', i === 0 ? 'false' : 'true');
          el.querySelectorAll('a').forEach((a) => (i === 0 ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
        });
        dots.forEach((d, i) => (i === current() ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
        play();
      }

      function play() {
        clearTimeout(timer);
        if (!visible || reduce) return;
        const v = video(slides()[0]);
        if (!v) { timer = window.setTimeout(next, FALLBACK); return; }
        v.muted = true;
        v.play().catch(() => { timer = window.setTimeout(next, FALLBACK); });
      }

      function move(steps: number) {
        if (busy || steps === 0) return;
        busy = true;
        clearTimeout(timer);
        const kids = slides();
        const n = Math.abs(steps);
        if (steps > 0) {
          // Slide left by n projects, then move the ones that left to the end of the line.
          track.style.transform = shift(n);
          const done = () => {
            for (let i = 0; i < n; i++) track.appendChild(kids[i]);
            track.style.transition = 'none';
            track.style.transform = 'none';
            void track.offsetWidth;
            track.style.transition = '';
            busy = false; settle();
          };
          reduce ? done() : track.addEventListener('transitionend', done, { once: true });
        } else {
          // Going back: bring the earlier projects in from the left.
          for (let i = 0; i < n; i++) track.prepend(slides()[kids.length - 1]);
          track.style.transition = 'none';
          track.style.transform = shift(n);
          void track.offsetWidth;
          track.style.transition = '';
          track.style.transform = 'none';
          const done = () => { busy = false; settle(); };
          reduce ? done() : track.addEventListener('transitionend', done, { once: true });
        }
      }
      const next = () => move(1);

      slides().forEach((el) => {
        const v = video(el);
        v?.addEventListener('ended', () => {
          if (v !== video(slides()[0])) return;
          if (holding) { v.currentTime = 0; v.play().catch(() => {}); } else next();
        });
      });

      section.querySelector('[data-next]')?.addEventListener('click', () => move(1));
      section.querySelector('[data-prev]')?.addEventListener('click', () => move(-1));
      dots.forEach((d, i) => d.addEventListener('click', () => move(i - current())));

      // Hold still while someone is looking closely or using the keyboard inside it.
      const clip = section.querySelector('.work-clip')!;
      clip.addEventListener('mouseenter', () => (holding = true));
      clip.addEventListener('mouseleave', () => (holding = false));
      section.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches(':focus-visible')) holding = true; });
      section.addEventListener('focusout', () => (holding = false));

      // Swipe on phones and tablets.
      let x0 = 0, y0 = 0;
      clip.addEventListener('touchstart', (e) => { const t = (e as TouchEvent).touches[0]; x0 = t.clientX; y0 = t.clientY; }, { passive: true });
      clip.addEventListener('touchend', (e) => {
        const t = (e as TouchEvent).changedTouches[0];
        const dx = t.clientX - x0, dy = t.clientY - y0;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) move(dx < 0 ? 1 : -1);
      }, { passive: true });

      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) play(); else { clearTimeout(timer); video(slides()[0])?.pause(); }
      }, { threshold: 0.35 }).observe(section);

      settle();
    }
  </script>

  <section class="section cream testimonial" aria-label="What clients say">
    <div class="container narrow">
      <figure class="t-quote">
        <span class="t-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>
          <p>Working with Anita at She2She Media has been an absolute pleasure! She made the entire website design process feel easy and seamless, anticipating details we hadn't even thought of and guiding us every step of the way. She's incredibly knowledgeable and professional, yet warm, approachable, and genuinely fun to work with. We couldn't be happier with the experience and look forward to working with her for many years to come!</p>
        </blockquote>
        <figcaption>Mickie, <a href="https://www.dogsthatcook.com">Dogs That Cook</a></figcaption>
      </figure>
    </div>
  </section>

  <CtaBand above="var(--cream)" heading="Not sure what you need yet?" body="That's what the call is for. Bring your current site, or the lack of one, and we'll work out the next step together." />
</Base>

<style>
  .testimonial { text-align: center; }
  .t-quote { margin: 0; }
  .t-mark { display: block; font: 700 96px/.6 var(--sans); color: var(--magenta); height: 48px; }
  .t-quote blockquote { margin: 0 0 20px; }
  .t-quote p { font-size: clamp(1.15rem, 2.2vw, 1.4rem); line-height: 1.6; color: var(--ink); font-weight: 500; }
  .t-quote figcaption { font-weight: 600; color: var(--muted); }
  .t-quote figcaption a { font-weight: 600; }
  .hero { padding: 64px 0 72px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .ai-note { position: relative; z-index: 1; font-size: 13px; color: var(--muted); margin: 10px 4px 0; }
  .copy .lead { margin-bottom: 32px; }
  /* The hero glides up as the page opens, one item after another, matching the scroll
     animations further down. It runs in CSS so it starts on first paint: the page script
     can't animate things already on screen at load, because it reveals them in the same
     instant it hides them. */
  @media (prefers-reduced-motion: no-preference) {
    /* The title waits var(--title-delay) (set in global.css), then everything follows it */
    .hero .copy > *, .hero .photo { animation: hero-rise 1.2s cubic-bezier(.22,.61,.36,1) both; }
    .hero .copy > :nth-child(1) { animation-delay: var(--title-delay); }
    .hero .copy > :nth-child(2) { animation-delay: calc(var(--title-delay) + 140ms); }
    .hero .copy > :nth-child(3) { animation-delay: calc(var(--title-delay) + 280ms); }
    .hero .copy > :nth-child(4) { animation-delay: calc(var(--title-delay) + 420ms); }
    .hero .photo { animation-delay: calc(var(--title-delay) + 300ms); }
    @keyframes hero-rise { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
  }
  .small { font-size: 14px; color: var(--muted); margin-top: 14px; }
  .photo { position: relative; }
  .frame { position: relative; z-index: 1; border-radius: var(--radius); overflow: hidden; box-shadow: 0 24px 48px rgba(168,37,111,.18); border: 8px solid #fff; }
  .deco { position: absolute; right: -28px; bottom: -36px; width: 120px; height: 220px; z-index: 0; }
  .deco2 { position: absolute; left: -26px; top: 36px; width: 110px; height: 70px; z-index: 0; opacity: .85; }
  .promo { background: var(--magenta); color: #fff; position: relative; overflow: hidden; padding: 56px 0 72px; }
  .promo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; position: relative; z-index: 1; }
  .promo h2 { color: #fff; font-size: clamp(2.2rem, 4.6vw, 3.4rem); margin-bottom: .35em; }
  .promo-copy p { font-size: 1.15rem; max-width: 420px; margin-bottom: 28px; }
  .promo-pill { display: inline-block; background: #fff; color: var(--magenta-dark); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; border-radius: 999px; padding: 8px 18px; margin-bottom: 18px; }
  .paper-wrap { position: relative; }
  .paper { background: #fff; color: var(--ink); padding: 44px 36px 36px; transform: rotate(-1.6deg); box-shadow: 0 20px 40px rgba(60,0,35,.25);
    clip-path: polygon(0 3%, 4% 1%, 9% 3.5%, 14% .5%, 20% 3%, 26% 1%, 31% 3.5%, 37% .8%, 43% 2.8%, 49% .4%, 55% 3%, 61% 1.2%, 67% 3.4%, 73% .6%, 79% 2.7%, 85% .8%, 91% 3.2%, 96% 1%, 100% 2.6%, 100% 100%, 0 100%);
    background-image: radial-gradient(rgba(0,0,0,.035) 1px, transparent 1px); background-size: 4px 4px; }
  .offer { display: grid; gap: 2px; padding: 16px 0; border-bottom: 2px dashed var(--lilac); }
  .o-label { font-weight: 700; font-size: 1.05rem; }
  .o-price { font-size: 2.4rem; font-weight: 700; color: var(--magenta-dark); line-height: 1.15; }
  .o-price s { font-size: 1.05rem; font-weight: 500; color: var(--muted); margin-left: 8px; }
  .o-note { font-size: 15px; color: var(--muted); }
  .o-link { display: inline-block; margin-top: 18px; font-weight: 600; }
  .o-link::after { content: " →"; }
  .promo-badge { position: absolute; right: -18px; bottom: -34px; width: 104px; height: 104px; background: #fff; border-radius: 50%; padding: 8px; box-shadow: 0 8px 20px rgba(0,0,0,.15); z-index: 2; }
  @media (prefers-reduced-motion: no-preference) {
    .paper { animation: paper-float 7s ease-in-out infinite; }
    @keyframes paper-float { 0%, 100% { transform: rotate(-1.6deg) translateY(0); } 50% { transform: rotate(-.6deg) translateY(-8px); } }
  }
  .problem { text-align: center; }
  .problem .lead { margin: 0 auto; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
  .cards { perspective: 1200px; }
  .svc { text-decoration: none; color: var(--text); display: flex; flex-direction: column; border-top: 6px solid var(--magenta); will-change: transform; }
  .svc.reveal.in { transition: opacity 1s ease, transform .6s cubic-bezier(.22,.61,.36,1), box-shadow .6s ease; }
  .cards .svc:hover, .cards .svc:focus-visible { color: var(--text); transform: translateY(-14px) scale(1.04); box-shadow: 0 28px 50px rgba(168,37,111,.20); z-index: 2; }
  .svc:hover .price { color: var(--magenta-dark); }
  @media (prefers-reduced-motion: reduce) { .cards .svc:hover, .cards .svc:focus-visible { transform: none; } }
  .svc .price { margin-top: auto; font-size: 1.5rem; }
  /* How it works sits on black to separate it from the cream cards above and the work below */
  .how { background: var(--ink); color: #fff; }
  .how h2, .how h3 { color: #fff; }
  .how .eyebrow { color: var(--lilac); }
  .how .steps p { color: rgba(255,255,255,.75); }
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .steps li { position: relative; }
  .num { position: relative; display: inline-flex; width: 56px; height: 56px; border-radius: 50%; background: var(--magenta); color: #fff; font-weight: 700; font-size: 22px; align-items: center; justify-content: center; margin-bottom: 16px; z-index: 1; }
  /* Dashed line linking each step to the next (four-across layout only) */
  .steps li:not(:last-child)::before { content: ""; position: absolute; top: 27px; left: 68px; right: -16px; border-top: 2px dashed var(--lilac); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    /* Numbers pop in and the connecting line draws across as each step arrives */
    :global(.motion) .steps li .num { transform: scale(.2) rotate(-120deg); }
    :global(.motion) .steps li.in .num { transform: none; transition: transform .9s cubic-bezier(.34,1.56,.64,1) calc(var(--d, 0ms) + 250ms); }
    :global(.motion) .steps li:not(:last-child)::before { transform: scaleX(0); }
    :global(.motion) .steps li.in:not(:last-child)::before { transform: scaleX(1); transition: transform 1.1s ease-out calc(var(--d, 0ms) + 700ms); }
    /* A soft ring ripples out from each number in turn, 1 → 2 → 3 → 4, on a loop */
    .num::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 3px solid var(--magenta); opacity: 0; animation: ping 8s ease-out infinite; animation-delay: calc(2.5s + var(--i) * 2s); }
