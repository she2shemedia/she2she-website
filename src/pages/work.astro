---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

// Each project uses the same short format. Screenshots live in /images/work/ (set `image`, `w` and `h`).
const projects = [
  {
    name: 'Dogs That Cook',
    url: 'https://dogsthatcook.com',
    domain: 'dogsthatcook.com',
    line: 'A real recipe blog, hosted by two Jack Russell terriers.',
    needed: 'A home for the recipes that sends people to the YouTube videos where the recipes come to life.',
    built: "A searchable recipe database with filters by ingredient, diet and meal type, in a playful brand that doesn't get in the way of the food.",
    image: '/images/work/dogs-that-cook.jpg',
    w: 1400, h: 723,
  },
  {
    name: 'A. M. French',
    label: 'My own project',
    url: 'https://she2shemedia.wixstudio.com/hunkiedorie',
    domain: 'A. M. French author site',
    line: "The author site for my children's book series, Hunkie Dorie.",
    needed: 'A home for the first book and a place readers can follow along as the series grows.',
    built: 'A site that introduces the book and points readers to where to buy it.',
    image: '/images/work/am-french.jpg',
    w: 1400, h: 695,
  },
];
---
<Base
  title="Website Design Portfolio | She2She Media"
  description="Recent website projects for small businesses, with what each one needed and what I built."
>
  <section class="section intro">
    <div class="container">
      <span class="eyebrow">Work</span>
      <h1>Recent work</h1>
      <p class="lead">A few projects, what each one needed, and what I built.</p>
    </div>
  </section>

  {projects.map((p, i) => (
    <section class:list={['section', 'project', { cream: i % 2 === 1 }]}>
      <div class="container two">
        <a href={p.url} class="browser" aria-label={`Visit ${p.name}`}>
          <span class="chrome" aria-hidden="true"><i></i><i></i><i></i><b>{p.domain}</b></span>
          {p.image
            ? <img class="shot-img" src={p.image} alt={`The ${p.name} website homepage`} width={p.w} height={p.h} loading="lazy" />
            : <span class="shot"><span class="shot-title">{p.name}</span><span class="shot-sub">{p.line}</span></span>}
        </a>
        <div>
          {p.label && <span class="tag">{p.label}</span>}
          <h2>{p.name}</h2>
          <p class="lead">{p.line}</p>
          <h3>What they needed</h3>
          <p>{p.needed}</p>
          <h3>What I built</h3>
          <p>{p.built}</p>
          <a href={p.url}>Visit the site</a>
        </div>
      </div>
    </section>
  ))}

  <CtaBand above={projects.length % 2 === 0 ? 'var(--cream)' : '#fff'} heading="Want yours on this page?" />
</Base>

<style>
  .intro { padding-bottom: 24px; }
  .two { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
  .tag { display: inline-block; font-size: 13px; font-weight: 700; color: var(--magenta-dark); background: var(--magenta-soft); border-radius: 999px; padding: 4px 12px; margin-bottom: 12px; }
  h3 { margin-top: 1.2em; font-size: 1rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .browser { display: block; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 18px 40px rgba(0,0,0,.08); text-decoration: none; background: #fff; }
  .chrome { display: flex; align-items: center; gap: 6px; background: #f1edef; padding: 12px 16px; }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: var(--lilac); }
  .chrome b { margin-left: 12px; font-weight: 500; font-size: 13px; color: var(--muted); background: #fff; padding: 4px 12px; border-radius: 999px; }
  .shot { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; aspect-ratio: 16 / 10; background: var(--magenta-soft); padding: 24px; }
  .shot-title { font-size: 1.8rem; font-weight: 700; color: var(--ink); }
  .shot-sub { color: var(--muted); max-width: 320px; }
  .shot-img { width: 100%; display: block; }
  .browser:hover .shot-img { transform: scale(1.02); }
  @media (prefers-reduced-motion: no-preference) { .shot-img { transition: transform .8s cubic-bezier(.22,.61,.36,1); } }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; gap: 32px; } }
</style>
