---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description, image = '/images/og-default.jpg', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
        <link rel="icon" href="/she2shefavicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="She2She Media" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="t_ZiKJzqgi1oMkVLO9sTePi_aw002mYi4ctYFiRYDTU" />
    <meta name="msvalidate.01" content="A08049197893CFD525AA1F1AA9C3ECA5" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline>
      // Gentle glide-up-and-fade as sections scroll into view. Groups marked data-stagger
      // reveal their items one after another. Skipped entirely for reduced-motion visitors.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        var root = document.documentElement;
        var targets = [];
        document.querySelectorAll('main [data-stagger]').forEach(function (group) {
          Array.prototype.forEach.call(group.children, function (el, i) {
            el.classList.add('reveal');
            el.style.setProperty('--d', i * 140 + 'ms');
          });
        });
        document.querySelectorAll('main .container > *').forEach(function (el) {
          if (el.matches('[data-stagger]') || el.querySelector('[data-stagger]')) return;
          el.classList.add('reveal');
        });
        document.querySelectorAll('main .reveal').forEach(function (el) { targets.push(el); });
        root.classList.add('motion');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var el = en.target;
            el.classList.add('in');
            io.unobserve(el);
            // Clear the stagger delay once revealed so hover effects respond instantly.
            setTimeout(function () { el.style.removeProperty('--d'); }, 1800);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
