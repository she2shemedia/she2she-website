---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/gloock/latin-400.css';
import '../styles/global.css';
import '../styles/logo-anim.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import AuditPopup from '../components/AuditPopup.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description, image = '/images/og-default.jpg', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Business details for search engines and AI tools. Keep in step with the About page facts and pricing.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://www.she2shemedia.com/#business',
  name: 'She2She Media',
  legalName: 'She2She Media LLC',
  description: 'She2She Media is a branding, website and social media agency for women-owned businesses.',
  slogan: 'Branding. Websites. Socials. For Women Who Mean Business.',
  url: 'https://www.she2shemedia.com/',
  logo: 'https://www.she2shemedia.com/images/she2she-wordmark.png',
  image: 'https://www.she2shemedia.com/images/og-default.jpg',
  email: 'anita@she2shemedia.com',
  telephone: '+1-678-435-9858',
  foundingDate: '2023',
  founder: { '@type': 'Person', name: 'Anita Marie', jobTitle: 'Founder', url: 'https://www.she2shemedia.com/about' },
  address: { '@type': 'PostalAddress', addressCountry: 'US' },
  areaServed: 'Worldwide',
  audience: { '@type': 'BusinessAudience', audienceType: 'Women-owned small businesses' },
  priceRange: '$150–$4,000',
  knowsAbout: ['Branding', 'Website design', 'Social media management', 'Small business websites'],
  sameAs: [
    'https://www.linkedin.com/company/she2shemedia',
    'https://instagram.com/she2shemedia',
    'https://facebook.com/she2shemedia',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Branding (color palette, fonts and brand style guide)' }, price: '750', priceCurrency: 'USD' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website design, Starter (up to 3 pages)' }, price: '1300', priceCurrency: 'USD' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website design, Standard (4 to 6 pages)' }, price: '1750', priceCurrency: 'USD' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website design, Premium (7 to 10 pages)' }, price: '4000', priceCurrency: 'USD' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Social media management (12 posts a month)' }, price: '500', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: '500', priceCurrency: 'USD', unitText: 'month' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website care plan' }, price: '150', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: '150', priceCurrency: 'USD', unitText: 'month' } },
    ],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/she2shefavicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="She2She Media" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="google-site-verification" content="t_ZiKJzqgi1oMkVLO9sTePi_aw002mYi4ctYFiRYDTU" />
    <meta name="msvalidate.01" content="A08049197893CFD525AA1F1AA9C3ECA5" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <AuditPopup />
    <ChatWidget />
    <script is:inline>
      // Gentle glide-up-and-fade as sections scroll into view. Groups marked data-stagger
      // reveal their items one after another. Skipped entirely for reduced-motion visitors.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        var root = document.documentElement;
        var targets = [];
        document.querySelectorAll('main [data-stagger]').forEach(function (group) {
          Array.prototype.forEach.call(group.children, function (el, i) {
            el.classList.add('reveal');
            el.style.setProperty('--d', i * 140 + 'ms');
          });
        });
        document.querySelectorAll('main .container > *').forEach(function (el) {
          if (el.matches('[data-stagger]') || el.querySelector('[data-stagger]')) return;
          el.classList.add('reveal');
        });
        document.querySelectorAll('main .reveal').forEach(function (el) { targets.push(el); });
        root.classList.add('motion');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var el = en.target;
            el.classList.add('in');
            io.unobserve(el);
            // Clear the stagger delay once revealed so hover effects respond instantly.
            setTimeout(function () { el.style.removeProperty('--d'); }, 1800);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
