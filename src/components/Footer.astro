<style>
  .foot { background: var(--ink); color: #fff; padding: 64px 0 0; font-size: 15px; margin-top: 0; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; }
  .about img { width: 120px; margin-bottom: 16px; }
  .about p { max-width: 340px; color: #cfc6cb; }
  h2 { font-size: 14px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 14px; color: #fff; }
  nav, .grid > div:last-child { display: flex; flex-direction: column; gap: 8px; }
  a:not(.btn) { color: #fff; text-decoration: none; }
  a:not(.btn):hover { color: #fff; text-decoration: underline; text-decoration-color: var(--magenta); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .social { display: flex; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
  .social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid #3a3337; transition: background .15s, border-color .15s; }
  .social a:hover { background: var(--magenta); border-color: var(--magenta); text-decoration: none; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-top: 32px; padding-bottom: 24px; margin-top: 40px; border-top: 1px solid #3a3337; color: #cfc6cb; font-size: 14px; }
  .legal nav { flex-direction: row; flex-wrap: wrap; gap: 8px 20px; }
  .strip { height: 14px; opacity: .8; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
