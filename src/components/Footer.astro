---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="container grid">
    <div class="about">
      <img src="/images/she2she-wordmark-white.svg" alt="She2She Media" width="368" height="120" loading="lazy" />
      <p>Websites and marketing for women-owned businesses. Based in the US, working online with women-owned businesses everywhere.</p>
    </div>
    <nav aria-label="Footer">
      <h2>Pages</h2>
      <a href="/services">Services</a>
      <a href="/pricing">Pricing</a>
      <a href="/work">Work</a>
      <a href="/about">About</a>
      <a href="/faq">FAQ</a>
      <a href="/blog">Blog</a>
      <a href="/free-audit">Free website audit</a>
    </nav>
    <div>
      <h2>Contact</h2>
      <a href="mailto:anita@she2shemedia.com">anita@she2shemedia.com</a>
      <a href="tel:+16784359858">+1 678-435-9858</a>
      <div class="social">
        <a href="https://www.linkedin.com/company/she2shemedia" target="_blank" rel="noopener noreferrer" aria-label="She2She Media on LinkedIn (opens in a new tab)" class="img">
          <img class="off" src="/images/social/linkedin.png" alt="" width="48" height="48" loading="lazy" />
          <img class="on" src="/images/social/linkedin-hover.png" alt="" width="48" height="48" loading="lazy" />
        </a>
        <a href="https://instagram.com/she2shemedia" target="_blank" rel="noopener noreferrer" aria-label="She2She Media on Instagram (opens in a new tab)" class="img">
          <img class="off" src="/images/social/instagram.png" alt="" width="48" height="48" loading="lazy" />
          <img class="on" src="/images/social/instagram-hover.png" alt="" width="48" height="48" loading="lazy" />
        </a>
        <a href="https://facebook.com/she2shemedia" target="_blank" rel="noopener noreferrer" aria-label="She2She Media on Facebook (opens in a new tab)" class="img">
          <img class="off" src="/images/social/facebook.png" alt="" width="48" height="48" loading="lazy" />
          <img class="on" src="/images/social/facebook-hover.png" alt="" width="48" height="48" loading="lazy" />
        </a>
        <a href="https://wa.me/16784356262" target="_blank" rel="noopener noreferrer" aria-label="She2She Media on WhatsApp (opens in a new tab)" class="img">
          <img class="off" src="/images/social/whatsapp.png" alt="" width="48" height="48" loading="lazy" />
          <img class="on" src="/images/social/whatsapp-hover.png" alt="" width="48" height="48" loading="lazy" />
        </a>
      </div>
    </div>
  </div>
  <div class="container legal">
    <span>&copy; {year} She2She Media, LLC</span>
    <nav aria-label="Legal">
      <a href="/privacy">Privacy policy</a>
      <a href="/terms">Terms</a>
      <a href="/disclaimer">Disclaimer</a>
      <a href="/accessibility">Accessibility</a>
      <a href="/privacy#cookies" data-cookie-settings>Cookie settings</a>
    </nav>
  </div>
</footer>

<style>
  .foot { background: var(--ink); color: #fff; padding: 64px 0 0; font-size: 15px; margin-top: 0; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; }
  .about img { width: 190px; margin-bottom: 20px; }
  .about p { max-width: 340px; color: #cfc6cb; }
  h2 { font-family: var(--sans); font-weight: 700; font-size: 14px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 14px; color: #fff; }
  nav, .grid > div:last-child { display: flex; flex-direction: column; gap: 8px; }
  a:not(.btn) { color: #fff; text-decoration: none; }
  /* Text links: a magenta line slides in from the left on hover and out to the right, like the top menu */
  a:not(.btn):not(.social a) { position: relative; align-self: flex-start; }
  a:not(.btn):not(.social a)::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; border-radius: 2px; background: var(--magenta); transform: scaleX(0); transform-origin: right; }
  a:not(.btn):not(.social a):hover::after, a:not(.btn):not(.social a):focus-visible::after { transform: scaleX(1); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) { a:not(.btn):not(.social a)::after { transition: transform .45s cubic-bezier(.22,.61,.36,1); } }
  .social { display: flex; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
  /* Glossy 3D magenta buttons with white icons; on hover they flip to white with a magenta icon */
  .social a { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; border: 0; position: relative; color: #fff; text-decoration: none;
    background:
      radial-gradient(circle at 32% 24%, rgba(255,255,255,.6) 0, rgba(255,255,255,.18) 18%, rgba(255,255,255,0) 34%),
      radial-gradient(circle at 50% 45%, #e04aa2 0%, #ca328d 55%, #94195f 100%);
    box-shadow: inset 0 -4px 7px rgba(60,0,35,.35), inset 0 3px 5px rgba(255,255,255,.3), 0 5px 12px rgba(0,0,0,.5); }
  .social a svg { filter: drop-shadow(0 1.5px 1px rgba(60,0,35,.35)); }
  .social a:hover, .social a:focus-visible { color: var(--magenta);
    background:
      radial-gradient(circle at 32% 24%, rgba(255,255,255,1) 0, rgba(255,255,255,.6) 18%, rgba(255,255,255,0) 34%),
      radial-gradient(circle at 50% 45%, #ffffff 0%, #f6eaf1 55%, #d8bfcd 100%);
    box-shadow: inset 0 -4px 7px rgba(120,40,90,.25), inset 0 3px 5px rgba(255,255,255,.8), 0 5px 12px rgba(0,0,0,.5); }
  .social a:hover svg, .social a:focus-visible svg { filter: drop-shadow(0 1px 1px rgba(120,20,80,.25)); }
  /* Image buttons (her 3D icon set): magenta normally, the white version fades in on hover */
  .social a.img, .social a.img:hover, .social a.img:focus-visible { background: none; box-shadow: none; }
  .social a.img img { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .25s ease; }
  .social a.img .on { opacity: 0; }
  .social a.img:hover .on, .social a.img:focus-visible .on { opacity: 1; }
  .social a.img:hover .off, .social a.img:focus-visible .off { opacity: 0; }
  /* Coin spin: the icon flips around its vertical axis a couple of times and settles, like a coin spun on a table */
  @media (prefers-reduced-motion: no-preference) {
    .social a:hover, .social a:focus-visible { animation: coin-spin 2.2s cubic-bezier(.08,.8,.2,1); }
    @keyframes coin-spin { from { transform: perspective(300px) rotateY(0); } to { transform: perspective(300px) rotateY(1080deg); } }
  }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-top: 32px; padding-bottom: 24px; margin-top: 40px; border-top: 1px solid #3a3337; color: #cfc6cb; font-size: 14px; }
  .legal nav { flex-direction: row; flex-wrap: wrap; gap: 8px 20px; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
