---
// The closing call to action used at the bottom of every page.
// Headings can include <br class="br-desk"> for a line break that only applies on wider screens.
// `above` is still accepted so existing pages don't break, but the band now starts with a clean edge.
interface Props { heading: string; body?: string; above?: string }
const { heading, body } = Astro.props;
---
<section class="band">
  <div class="container inner">
    <h2 set:html={heading} />
    {body && <p>{body}</p>}
    <a href="/book-online" class="btn white">Book a free consultation</a>
  </div>
</section>
<style>
  .band { background: var(--magenta); color: #fff; padding: 72px 0 88px; position: relative; overflow: hidden; }
  .inner { position: relative; max-width: 760px; text-align: center; }
  h2 { color: #fff; }
  p { font-size: 1.15rem; margin: 0 auto 28px; max-width: 720px; }
  @media (max-width: 760px) {
    h2 :global(.br-desk) { display: none; }
  }
</style>
